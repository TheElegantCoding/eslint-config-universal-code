{
  "name": "eslint-config-universal-code",
  "description": "📦 Eslint configuration for help you to identify and fix these errors before they cause problems in your code. It can also help you to develop good coding habits that will make your code easier to maintain in the long run.",
  "author": {
    "name": "Luis Monsalve <TheElegantCoding>",
    "email": "luismonsalve1941@gmail.com"
  },
  "version": "1.1.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheElegantCoding/eslint-config-universal-code.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "eslintplugin",
    "eslint-plugin",
    "eslint-rules",
    "eslint-shareable-configs",
    "linter",
    "linter-eslint",
    "linter-config",
    "style-guide",
    "styleguide",
    "typescript",
    "clean-code",
    "javascript",
    "code-style"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["./dist"],
  "engines": {
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "bunx gitlys init",
    "release": "bun run build && bunx gitlys release",
    "typegen": "bun scripts/type_generator.ts",
    "watch": "tsup --watch",
    "build": "tsup",
    "dev": "npx @eslint/config-inspector --config eslint.config.js",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "type-check": "tsc --pretty --noEmit",
    "lint": "pnpm lint-eslint",
    "lint-eslint": "eslint . --fix "
  },
  "peerDependencies": {
    "eslint": ">=10.8.1"
  },
  "dependencies": {
    "@html-eslint/eslint-plugin": "0.64.0",
    "@html-eslint/parser": "^0.64.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "astro-eslint-parser": "3.1.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsonc": "3.4.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-tailwindcss": "4.2.0",
    "eslint-plugin-unicorn": "73.0.0",
    "eslint-plugin-yml": "3.8.1",
    "globals": "^17.4.0",
    "jsonc-eslint-parser": "3.3.0",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@eslint/config-inspector": "3.2.0",
    "@types/eslint": "9.6.1",
    "@types/eslint-plugin-tailwindcss": "3.17.0",
    "@types/node": "^26.2.0",
    "eslint-typegen": "^2.3.1",
    "gitlys": "^2.2.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
